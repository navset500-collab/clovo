GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: a password required for new analyses on your public demo.
ANALYSIS_ACCESS_CODE=

# Required: private Vercel Blob store for durable usage protection and studies.
BLOB_READ_WRITE_TOKEN=
# Set false and redeploy to stop new reviews.
ANALYSIS_ENABLED=true
# Optional. Without a key, research uses Tavily's free, rate-limited mode.
TAVILY_API_KEY=
